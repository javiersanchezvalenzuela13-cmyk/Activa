<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.activa.controller.usuario.MainController"
            stylesheets="@../css/styles.css"
            styleClass="app">

    <!-- Barra lateral -->
    <left>
        <VBox spacing="22" prefWidth="248" minWidth="248" styleClass="side">

            <!-- Logo -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="brand">
                <StackPane fx:id="marca" styleClass="brand-mark"/>
                <Label text="activa" styleClass="brand-texto"/>
            </HBox>

            <!-- Descubrir -->
            <VBox spacing="3">
                <Label text="DESCUBRIR" styleClass="nav-eyebrow"/>
                <Button fx:id="btnInicio" text="Inicio" maxWidth="Infinity"
                        styleClass="nav-item" onAction="#onInicio"/>
                <Button fx:id="btnMisInscripciones" text="Mis inscripciones" maxWidth="Infinity"
                        styleClass="nav-item" onAction="#onMisInscripciones"/>
                <Button fx:id="btnCalendario" text="Calendario" maxWidth="Infinity"
                        styleClass="nav-item" onAction="#onCalendario"/>
                <Button fx:id="btnPagos" text="Pagos" maxWidth="Infinity"
                        styleClass="nav-item" onAction="#onPagos"/>
            </VBox>

            <!-- Administración (solo se ve si el usuario es admin) -->
            <VBox fx:id="grupoAdmin" spacing="3">
                <Label text="ADMINISTRACIÓN" styleClass="nav-eyebrow"/>
                <Button fx:id="btnPanelAdmin" text="Panel admin" maxWidth="Infinity"
                        styleClass="nav-item" onAction="#onPanelAdmin"/>
            </VBox>

            <!-- Preferencias -->
            <VBox spacing="3">
                <Label text="PREFERENCIAS" styleClass="nav-eyebrow"/>
                <Button fx:id="btnAjustes" text="Ajustes" maxWidth="Infinity"
                        styleClass="nav-item" onAction="#onAjustes"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Caja de ayuda -->
            <StackPane fx:id="ayuda" styleClass="helpbox">
                <Circle radius="40" styleClass="helpbox-circulo"
                        StackPane.alignment="TOP_RIGHT" translateX="22" translateY="-22"/>
                <VBox spacing="10" styleClass="helpbox-contenido">
                    <Label text="¿Necesitas una mano?" wrapText="true" maxWidth="150"
                           styleClass="helpbox-titulo"/>
                    <Label text="Pregunta al asistente. Si es algo concreto, te pasa con una persona del equipo."
                           wrapText="true" styleClass="helpbox-texto"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Circle radius="4" styleClass="punto-online"/>
                        <Label text="Equipo disponible · respuesta en menos de 2 h"
                               wrapText="true" styleClass="helpbox-online"/>
                    </HBox>
                    <Button fx:id="btnAsistente" text="Abrir asistente" styleClass="helpbox-boton"/>
                </VBox>
            </StackPane>
        </VBox>
    </left>

    <!-- Zona principal: barra superior + pantalla actual -->
    <center>
        <BorderPane fx:id="contenedor" styleClass="main">

            <top>
                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="top">

                    <!-- Buscador -->
                    <HBox fx:id="cajaBuscar" spacing="10" alignment="CENTER_LEFT"
                          maxWidth="460" HBox.hgrow="ALWAYS" styleClass="search">
                        <TextField fx:id="txtBuscar" promptText="Busca yoga, cerámica, rutas…"
                                   HBox.hgrow="ALWAYS" styleClass="search-campo"/>
                    </HBox>

                    <!-- Menú de etiquetas -->
                    <MenuButton fx:id="menuEtiquetas" text="Etiquetas" styleClass="filtro-etiquetas"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Guardados y notificaciones -->
                    <Button fx:id="btnGuardados" styleClass="iconbtn"/>
                    <Button fx:id="btnNotificaciones" onAction="#onNotificaciones" styleClass="iconbtn"/>

                    <!-- Solo para invitados -->
                    <HBox fx:id="botonesInvitado" spacing="8" alignment="CENTER_LEFT"
                          visible="false" managed="false">
                        <Button text="Iniciar sesión" styleClass="boton-ghost" onAction="#onIniciarSesion"/>
                        <Button text="Crear cuenta" styleClass="boton-apuntarme" onAction="#onCrearCuenta"/>
                    </HBox>

                    <!-- Usuario -->
                    <MenuButton fx:id="menuUsuario" styleClass="me">
                        <graphic>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <VBox alignment="CENTER_RIGHT">
                                    <Label fx:id="lblUsuario" styleClass="me-nombre"/>
                                    <Label fx:id="lblRol" styleClass="me-rol"/>
                                </VBox>
                                <Label fx:id="lblInicial" styleClass="avatar"/>
                            </HBox>
                        </graphic>
                        <items>
                            <!-- Acciones del menú -->
                            <MenuItem text="Mi perfil" onAction="#onMiPerfil"/>
                            <MenuItem text="Mis etiquetas" onAction="#onMisEtiquetas"/>
                            <MenuItem text="Métodos de pago" onAction="#onMetodosPago"/>
                            <MenuItem text="Notificaciones" onAction="#onNotificaciones"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Cerrar sesión" styleClass="salir" onAction="#onCerrarSesion"/>
                        </items>
                    </MenuButton>
                </HBox>
            </top>

            <!-- El centro lo rellena el Navegador -->
        </BorderPane>
    </center>
</BorderPane>