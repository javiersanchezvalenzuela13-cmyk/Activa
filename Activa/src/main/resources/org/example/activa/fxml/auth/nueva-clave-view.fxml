<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.activa.controller.auth.NuevaClaveController"
      stylesheets="@../../css/auth.css"
      styleClass="root-container">

    <VBox spacing="15" alignment="CENTER_LEFT" prefWidth="480">
        <padding>
            <Insets top="40" right="50" bottom="40" left="50"/>
        </padding>

        <Label text="activa"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Georgia'; -fx-font-style: italic;"/>

        <HBox spacing="8" prefHeight="4">
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color: #215745; -fx-background-radius: 2;"/>
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color: #215745; -fx-background-radius: 2;"/>
        </HBox>

        <VBox spacing="4">
            <Label text="RECUPERAR ACCESO - PASO 2 DE 2" styleClass="subtitle"/>
            <TextFlow>
                <Text text="Crea una " styleClass="title"/>
                <Text text="contraseña" styleClass="title-accent"/>
                <Text text=" nueva." styleClass="title"/>
            </TextFlow>
            <Label fx:id="mensajeCorreoLabel" text="Si existe una cuenta con ..., te hemos enviado un código de 6 dígitos. Caduca en 15 minutos." wrapText="true"
                   styleClass="description-text"/>
        </VBox>

        <VBox spacing="15" VBox.vgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="codigo1" styleClass="code-input"/>
                <TextField fx:id="codigo2" styleClass="code-input"/>
                <TextField fx:id="codigo3" styleClass="code-input"/>
                <TextField fx:id="codigo4" styleClass="code-input"/>
                <TextField fx:id="codigo5" styleClass="code-input"/>
                <TextField fx:id="codigo6" styleClass="code-input"/>
            </HBox>

            <VBox spacing="5">
                <Label text="Contraseña nueva" styleClass="label-form"/>
                <PasswordField fx:id="nuevaPasswordField" styleClass="custom-text-field"/>
                <Label text="Mínimo 8 caracteres, con al menos un número."
                       styleClass="description-text" style="-fx-font-size: 11px;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Repite la contraseña" styleClass="label-form"/>
                <PasswordField fx:id="repetirPasswordField" styleClass="custom-text-field"/>
            </VBox>

            <Button fx:id="btnGuardar" text="Guardar contraseña" maxWidth="Infinity"
                    styleClass="btn-primary" onAction="#handleGuardarContrasena"/>
        </VBox>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Hyperlink text="← Cambiar de correo"
                       style="-fx-text-fill: #666; -fx-underline: false;"
                       onAction="#handleVolverPaso1"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Reenviar código"
                       style="-fx-text-fill: #215745; -fx-underline: false;"
                       onAction="#handleReenviarCodigo"/>
        </HBox>
    </VBox>

    <StackPane HBox.hgrow="ALWAYS" styleClass="right-panel">
        <GridPane hgap="15" vgap="15" alignment="CENTER">
            <Region prefWidth="240" prefHeight="290" GridPane.columnIndex="0" GridPane.rowIndex="0"
                    style="-fx-background-color: #2A6A54; -fx-background-radius: 20;"/>
            <Region prefWidth="240" prefHeight="290" GridPane.columnIndex="1" GridPane.rowIndex="0"
                    style="-fx-background-color: #388B6E; -fx-background-radius: 20;"/>
            <Region prefWidth="240" prefHeight="290" GridPane.columnIndex="0" GridPane.rowIndex="1"
                    style="-fx-background-color: #1A4537; -fx-background-radius: 20;"/>
            <Region prefWidth="240" prefHeight="290" GridPane.columnIndex="1" GridPane.rowIndex="1"
                    style="-fx-background-color: #43A583; -fx-background-radius: 20;"/>
        </GridPane>

        <VBox maxWidth="270" maxHeight="90" alignment="CENTER_LEFT"
              StackPane.alignment="CENTER" styleClass="floating-card">
            <Label text="La seguridad de tu cuenta es nuestra prioridad." wrapText="true"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </VBox>
    </StackPane>
</HBox>