<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<?import javafx.scene.layout.StackPane?>
<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.activa.controller.admin.EditorActividadController"
            fitToWidth="true" styleClass="scroll">

    <VBox fx:id="contenido" spacing="24" styleClass="contenido">

        <!-- Volver y título -->
        <Button text="← Volver al panel" styleClass="boton-volver" onAction="#onCancelar"/>
        <VBox spacing="6">
            <Label text="ADMINISTRACIÓN" styleClass="eyebrow"/>
            <TextFlow>
                <Text fx:id="txtTitulo" text="Crear " styleClass="h1"/>
                <Text text="actividad" styleClass="h1-em-admin"/>
            </TextFlow>
        </VBox>

        <HBox spacing="24">

            <!-- Formulario -->
            <VBox spacing="20" HBox.hgrow="ALWAYS" styleClass="formulario">

                <VBox spacing="12" styleClass="bloque">
                    <Label text="Información básica" styleClass="bloque-titulo"/>
                    <Label text="Nombre" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtNombre" promptText="Ej.: Yoga al aire libre"/>
                    <Label text="Descripción" styleClass="campo-etiqueta"/>
                    <TextArea fx:id="txtDescripcion" promptText="Qué se hará, qué hay que traer..."
                              wrapText="true" prefRowCount="4"/>
                </VBox>

                <VBox spacing="12" styleClass="bloque">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Etiquetas" styleClass="bloque-titulo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblContadorEtiquetas" styleClass="campo-ayuda-neutro"/>
                    </HBox>
                    <VBox fx:id="cajaEtiquetas" spacing="12"/>
                </VBox>
                <VBox spacing="12" styleClass="bloque">
                    <Label text="Foto" styleClass="bloque-titulo"/>
                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <StackPane fx:id="cajaFoto"/>
                        <VBox spacing="8">
                            <Label text="JPG o PNG, máximo 2 MB." styleClass="campo-ayuda-neutro"/>
                            <HBox spacing="8">
                                <Button text="Elegir foto…" styleClass="boton-ghost-borde" onAction="#onElegirFoto"/>
                                <Button fx:id="btnQuitarFoto" text="Quitar" styleClass="boton-ghost" onAction="#onQuitarFoto"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="12" styleClass="bloque">
                    <Label text="Cuándo y dónde" styleClass="bloque-titulo"/>
                    <Label text="Lugar" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtLugar" promptText="Ej.: Parque del Retiro"/>
                    <HBox spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Fecha" styleClass="campo-etiqueta"/>
                            <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Empieza" styleClass="campo-etiqueta"/>
                            <ComboBox fx:id="cbInicio" prefWidth="120"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Termina" styleClass="campo-etiqueta"/>
                            <ComboBox fx:id="cbFin" prefWidth="120"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="12" styleClass="bloque">
                    <Label text="Plazas y precio" styleClass="bloque-titulo"/>
                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                        <VBox spacing="6">
                            <Label text="Plazas" styleClass="campo-etiqueta"/>
                            <Spinner fx:id="spnPlazas" editable="true" prefWidth="120"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Precio por plaza (€)" styleClass="campo-etiqueta"/>
                            <TextField fx:id="txtPrecio" promptText="0,00" prefWidth="140"/>
                        </VBox>
                        <CheckBox fx:id="chkGratis" text="Actividad gratuita"/>
                    </HBox>
                    <Label fx:id="lblAvisoPlazas" styleClass="campo-ayuda" wrapText="true"
                           visible="false" managed="false"/>
                </VBox>

                <!-- Botones -->
                <HBox spacing="10">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Cancelar" styleClass="boton-ghost" onAction="#onCancelar"/>
                    <Button fx:id="btnGuardar" text="Crear actividad" styleClass="boton-apuntarme"
                            onAction="#onGuardar"/>
                </HBox>
            </VBox>

            <!-- Vista previa -->
            <VBox spacing="10" prefWidth="300" minWidth="280">
                <Label text="VISTA PREVIA" styleClass="eyebrow"/>
                <VBox fx:id="vistaPrevia"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>