<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox styleClass="root-container" stylesheets="@auth.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.activa.controller.auth.RegistroController">

    <VBox alignment="CENTER_LEFT" prefWidth="480" spacing="18">
        <padding><Insets bottom="40" left="50" right="50" top="40" /></padding>

        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Georgia'; -fx-font-style: italic;" text="activa" />

        <HBox prefHeight="4" spacing="8">
            <Region style="-fx-background-color: #215745; -fx-background-radius: 2;" HBox.hgrow="ALWAYS" />
            <Region style="-fx-background-color: #DCD7C5; -fx-background-radius: 2;" HBox.hgrow="ALWAYS" />
        </HBox>

        <VBox spacing="5">
            <Label styleClass="subtitle" text="PASO 1 DE 2" />
            <TextFlow>
                <Text styleClass="title" text="Crea tu " />
                <Text styleClass="title-accent" text="cuenta." />
            </TextFlow>
            <Label styleClass="description-text" text="Solo te pedimos lo necesario para apuntarte a actividades." wrapText="true" />
        </VBox>

        <VBox spacing="12">
            <VBox spacing="4">
                <Label styleClass="label-form" text="Nombre" />
                <TextField fx:id="nombreField" promptText="Nombre" styleClass="custom-text-field" />
            </VBox>

            <VBox spacing="4">
                <Label styleClass="label-form" text="Correo electrónico" />
                <TextField fx:id="emailField" promptText="Correo electrónico" styleClass="custom-text-field" />
            </VBox>

            <VBox spacing="4">
                <Label styleClass="label-form" text="Contraseña" />
                <PasswordField fx:id="passwordField" promptText="Contraseña" styleClass="custom-text-field" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #888;" text="Mínimo 8 caracteres, con al menos un número." />
            </VBox>

            <CheckBox fx:id="terminosCheck" style="-fx-font-size: 12px; -fx-text-fill: #444;" text="Acepto las normas de la comunidad y la política de privacidad" wrapText="true" />

            <Button maxWidth="Infinity" onAction="#handleContinuar" styleClass="btn-primary" text="Continuar →" />
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="5">
            <Label styleClass="description-text" text="¿Ya tienes cuenta?" />
            <Hyperlink onAction="#handleIrLogin" style="-fx-text-fill: #215745; -fx-font-weight: bold;" text="Inicia sesión" />
        </HBox>
    </VBox>

    <StackPane styleClass="right-panel" HBox.hgrow="ALWAYS">
        <GridPane alignment="CENTER" hgap="15" vgap="15">
            <Region prefHeight="290" prefWidth="240" style="-fx-background-color: #C39938; -fx-background-radius: 20;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Region prefHeight="290" prefWidth="240" style="-fx-background-color: #386A8B; -fx-background-radius: 20;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Region prefHeight="290" prefWidth="240" style="-fx-background-color: #C39938; -fx-background-radius: 20;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Region prefHeight="290" prefWidth="240" style="-fx-background-color: #7D5B8C; -fx-background-radius: 20;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <VBox alignment="CENTER_LEFT" maxHeight="90" maxWidth="260" styleClass="floating-card" StackPane.alignment="CENTER">
            <Label style="-fx-font-family: 'Georgia'; -fx-font-size: 16px; -fx-font-weight: bold;" text="Más de 3.000 vecinos ya se mueven con Activa." wrapText="true" />
        </VBox>
    </StackPane>
</HBox>
