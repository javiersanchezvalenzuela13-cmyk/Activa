<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="pag-scroll" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.activa.controller.usuario.PagoController">

    <content>
        <VBox spacing="22.0" styleClass="pag-root">
            <padding>
                <Insets bottom="36.0" left="36.0" right="36.0" top="28.0" />
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2.0">
                    <Label styleClass="pag-kicker" text="PAGOS" />
                    <HBox alignment="BASELINE_LEFT">
                        <Label styleClass="pag-title" text="Cuentas " />
                        <Label styleClass="pag-title-accent" text="claras" />
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnMetodosPago" onAction="#abrirMetodosPago" styleClass="pag-btn-outline" text="💳  Métodos de pago" />
            </HBox>

            <VBox fx:id="panelInvitado" alignment="CENTER" managed="false" spacing="14.0" styleClass="panel, vacio-caja" visible="false">
                <StackPane fx:id="iconoInvitado" styleClass="vacio-icono" />
                <Label styleClass="vacio-titulo" text="Inicia sesión para ver tus pagos" />
                <Label styleClass="vacio-texto" text="Con una cuenta podrás consultar tus movimientos, abonar actividades y gestionar tus métodos de pago." wrapText="true" />
                <Button onAction="#onIniciarSesion" styleClass="boton-apuntarme" text="Iniciar sesión" />
            </VBox>

            <HBox fx:id="bannerPendiente" alignment="CENTER_LEFT" spacing="14.0" styleClass="pag-banner">
                <StackPane styleClass="pag-banner-icon-circle">
                    <Label styleClass="pag-banner-icon" text="!" />
                </StackPane>

                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblBannerTitulo" styleClass="pag-banner-title" text="Tienes 1 pago pendiente" />
                    <Label fx:id="lblBannerDetalle" styleClass="pag-banner-sub" text="Taller de cerámica · 12,00 €. Págalo antes de la actividad para mantener tu plaza." />
                </VBox>

                <Button fx:id="btnPagarAhora" onAction="#pagarSiguientePendiente" styleClass="pag-btn-primary" text="Pagar ahora" />
            </HBox>

            <HBox fx:id="cajaKpis" spacing="18.0">
                <VBox maxWidth="Infinity" spacing="8.0" styleClass="pag-kpi-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="pag-kpi-label" text="💳  Pagado este año" />
                    <Label fx:id="lblTotalPagado" styleClass="pag-kpi-amount" text="21,50 €" />
                    <Label fx:id="lblCountPagado" styleClass="pag-kpi-sub" text="3 actividades" />
                </VBox>

                <VBox maxWidth="Infinity" spacing="8.0" styleClass="pag-kpi-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="pag-kpi-label" text="🕒  Pendiente" />
                    <Label fx:id="lblTotalPendiente" styleClass="pag-kpi-amount" text="12,00 €" />
                    <Label fx:id="lblCountPendiente" styleClass="pag-kpi-sub" text="1 pago" />
                </VBox>

                <VBox maxWidth="Infinity" spacing="8.0" styleClass="pag-kpi-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="pag-kpi-label" text="↺  Reembolsado" />
                    <Label fx:id="lblTotalReembolsado" styleClass="pag-kpi-amount" text="5,00 €" />
                    <Label fx:id="lblCountReembolsado" styleClass="pag-kpi-sub" text="1 devolución" />
                </VBox>
            </HBox>

            <VBox fx:id="cajaTabla" styleClass="pag-table-box">
                <HBox alignment="CENTER_LEFT" styleClass="pag-table-header">
                    <Label maxWidth="Infinity" styleClass="pag-th" text="ACTIVIDAD" HBox.hgrow="ALWAYS" />
                    <Label prefWidth="110.0" styleClass="pag-th" text="FECHA" />
                    <Label prefWidth="160.0" styleClass="pag-th" text="MÉTODO" />
                    <Label alignment="CENTER_RIGHT" prefWidth="110.0" styleClass="pag-th" text="IMPORTE" />
                    <Label prefWidth="150.0" styleClass="pag-th-estado" text="ESTADO" />
                    <Region prefWidth="110.0" />
                </HBox>

                <VBox fx:id="contenedorFilasPagos" />
            </VBox>

        </VBox>
    </content>
    <stylesheets>
        <URL value="@../../css/pagos.css" />
    </stylesheets>
</ScrollPane>