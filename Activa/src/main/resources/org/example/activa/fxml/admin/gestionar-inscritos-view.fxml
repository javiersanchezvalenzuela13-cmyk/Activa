<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.activa.controller.admin.GestionarInscritosController"
            fitToWidth="true" styleClass="scroll">

    <fx:define>
        <ToggleGroup fx:id="grupoFiltro"/>
    </fx:define>

    <VBox fx:id="contenido" spacing="24" styleClass="contenido">

        <Button text="← Volver al panel" styleClass="boton-volver" onAction="#onVolver"/>

        <HBox spacing="18" alignment="CENTER_LEFT">
            <StackPane fx:id="cajaMiniatura"/>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label fx:id="lblNombre" styleClass="titulo-gestion" wrapText="true"/>
                <Label fx:id="lblDatos" styleClass="tarjeta-dato"/>
            </VBox>
            <Button fx:id="btnEditar" text="Editar" styleClass="boton-ghost-borde" onAction="#onEditar"/>
        </HBox>

        <HBox fx:id="kpis" spacing="14"/>

        <VBox fx:id="panel" styleClass="panel">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="panel-cabecera">
                <HBox spacing="4" styleClass="seg">
                    <ToggleButton fx:id="tabInscritos" text="Inscritos" selected="true"
                                  toggleGroup="$grupoFiltro" styleClass="seg-boton"/>
                    <ToggleButton fx:id="tabCancelados" text="Cancelados"
                                  toggleGroup="$grupoFiltro" styleClass="seg-boton"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox fx:id="cajaBuscar" spacing="8" alignment="CENTER_LEFT" prefWidth="260" styleClass="search">
                    <TextField fx:id="txtBuscar" promptText="Buscar persona" HBox.hgrow="ALWAYS"
                               styleClass="search-campo"/>
                </HBox>
            </HBox>

            <HBox fx:id="cabeceraTabla" spacing="16" alignment="CENTER_LEFT" styleClass="tabla-cabecera"/>
            <VBox fx:id="filas"/>
        </VBox>
    </VBox>
</ScrollPane>