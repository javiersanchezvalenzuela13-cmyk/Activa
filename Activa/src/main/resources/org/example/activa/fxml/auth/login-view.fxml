<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox styleClass="root-container" stylesheets="@login-view.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.activa.controller.auth.LoginController">

    <VBox alignment="CENTER_LEFT" prefWidth="450" spacing="20">
        <padding>
            <Insets bottom="40" left="50" right="50" top="40" />
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Georgia'; -fx-font-style: italic;" text="activa" />
        </HBox>

        <VBox spacing="5">
            <Label styleClass="subtitle" text="BIENVENIDO DE NUEVO" />
            <TextFlow>
                <Text styleClass="title" text="Tu barrio tiene " />
                <Text styleClass="title-accent" text="planes" />
                <Text styleClass="title" text=" esta semana." />
            </TextFlow>
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label styleClass="label-form" text="Correo electrónico" />
                <TextField fx:id="emailField" promptText="Correo electrónico" styleClass="custom-text-field" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="label-form" text="Contraseña" />
                <PasswordField fx:id="passwordField" promptText="Contraseña" styleClass="custom-text-field" />
            </VBox>

            <HBox alignment="CENTER">
                <CheckBox style="-fx-text-fill: #666;" text="Recordarme" />
                <Region HBox.hgrow="ALWAYS" /> <!-- Empuja los elementos a los lados -->
                <Hyperlink style="-fx-text-fill: #666; -fx-underline: false;" text="¿Olvidaste la contraseña?" />
            </HBox>

            <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="btn-primary" text="Iniciar sesión →" />
        </VBox>

        <Label alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: #999;" text="o" />

        <HBox spacing="10">
            <Button maxWidth="Infinity" styleClass="btn-secondary" text="Continuar con Google" HBox.hgrow="ALWAYS" />
            <Button maxWidth="Infinity" styleClass="btn-secondary" text="Explorar sin cuenta" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="5">
            <Label style="-fx-text-fill: #666;" text="¿Aún no tienes cuenta?" />
            <Hyperlink style="-fx-text-fill: #215745; -fx-font-weight: bold;" text="Crear cuenta" />
        </HBox>
    </VBox>

    <StackPane styleClass="right-panel" HBox.hgrow="ALWAYS">

        <GridPane alignment="CENTER" hgap="15" vgap="15">
            <Region prefHeight="300" prefWidth="250" style="-fx-background-color: #D28C70; -fx-background-radius: 20;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Region prefHeight="300" prefWidth="250" style="-fx-background-color: #4A809E; -fx-background-radius: 20;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Region prefHeight="300" prefWidth="250" style="-fx-background-color: #C36A47; -fx-background-radius: 20;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Region prefHeight="300" prefWidth="250" style="-fx-background-color: #7D5B8C; -fx-background-radius: 20;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <VBox alignment="CENTER_LEFT" maxHeight="100" maxWidth="250" spacing="5" styleClass="floating-card" StackPane.alignment="CENTER">
            <Label prefHeight="19.0" prefWidth="231.0" style="-fx-font-family: 'Georgia'; -fx-font-size: 16px; -fx-font-weight: bold;" text="142 actividades este mes cerca de ti." />
            <Label style="-fx-font-size: 11px; -fx-text-fill: #666;" text="Yoga en el parque, talleres, rutas y huertos. Apúntate en dos toques." wrapText="true" />
        </VBox>
    </StackPane>

</HBox>
